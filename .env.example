# Browser-safe Supabase configuration. These values are intentionally public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anonymous-key

# Server-only credentials. Never prefix these names with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
THE_ODDS_API_KEY=your-server-only-odds-api-key
OPENAI_API_KEY=
ODDS_API_MONTHLY_ALLOWANCE=500

# Comma-separated Supabase user UUIDs permitted to view the API quota dashboard.
APP_ADMIN_USER_IDS=

# Optional server-only authentication for future scheduled endpoints.
CRON_SECRET=replace-with-a-random-server-only-value
